# ActiveCollab API Configuration
ACTIVECOLLAB_URL=https://app.activecollab.com/YOUR_ACCOUNT_ID
ACTIVECOLLAB_TOKEN=YOUR_USER_ID-YOUR_TOKEN_STRING

# MCP Server Configuration
# Transport mode: 'stdio' (for local desktop apps like Claude Desktop) or 'sse' (for Kubernetes / remote HTTP)
MCP_TRANSPORT=sse
PORT=3000
